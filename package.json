{
  "name": "pharmapos",
  "version": "1.0.0",
  "description": "Offline-first pharmacy POS for small pharmacies in Malawi",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
